    <profiles>
        <!--
            Release profile: automates the full release workflow.
            Usage: ./mvnw validate -Prelease

            Steps performed:
            1. Parse current version (build-helper-maven-plugin)
            2. Remove -SNAPSHOT suffix (versions-maven-plugin via exec)
            3. Commit release version
            4. Build, test, sign, and deploy to Maven Central
            5. Tag the release (no 'v' prefix)
            6. Bump minor version to next -SNAPSHOT
            7. Commit next development version
            8. Push commits and tags to origin
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Parse current version into components -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>parse-version</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>parse-version</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Orchestrate release steps -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <!-- Step 1: Set release version (remove -SNAPSHOT) -->
                            <execution>
                                <id>set-release-version</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>./mvnw</executable>
                                    <arguments>
                                        <argument>versions:set</argument>
                                        <argument>-DnewVersion=${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                        <argument>-DgenerateBackupPoms=false</argument>
                                        <argument>-q</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 2: Stamp CHANGELOG.md — move Unreleased entries under new version heading -->
                            <execution>
                                <id>stamp-changelog</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>perl</executable>
                                    <arguments>
                                        <argument>-i</argument>
                                        <argument>-pe</argument>
                                        <argument>s/^## Unreleased$/## Unreleased\n\n### Added\n\n### Changed\n\n### Fixed\n\n### Removed\n\n## [${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}]/</argument>
                                        <argument>CHANGELOG.md</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 3: Commit release version -->
                            <execution>
                                <id>git-commit-release</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>git</executable>
                                    <arguments>
                                        <argument>commit</argument>
                                        <argument>-am</argument>
                                        <argument>Release ${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 4: Build, test, sign, and deploy to Maven Central -->
                            <execution>
                                <id>deploy-release</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>./mvnw</executable>
                                    <arguments>
                                        <argument>clean</argument>
                                        <argument>deploy</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 5: Tag the release -->
                            <execution>
                                <id>git-tag</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>git</executable>
                                    <arguments>
                                        <argument>tag</argument>
                                        <argument>release_${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 6: Bump to next minor SNAPSHOT version -->
                            <execution>
                                <id>set-next-snapshot</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>./mvnw</executable>
                                    <arguments>
                                        <argument>versions:set</argument>
                                        <argument>-DnewVersion=${parsedVersion.majorVersion}.${parsedVersion.nextMinorVersion}.0-SNAPSHOT</argument>
                                        <argument>-DgenerateBackupPoms=false</argument>
                                        <argument>-q</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 7: Commit next development version -->
                            <execution>
                                <id>git-commit-snapshot</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>git</executable>
                                    <arguments>
                                        <argument>commit</argument>
                                        <argument>-am</argument>
                                        <argument>Next ${parsedVersion.majorVersion}.${parsedVersion.nextMinorVersion}.0-SNAPSHOT</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <!-- Step 8: Push commits and tags -->
                            <execution>
                                <id>git-push</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>git</executable>
                                    <arguments>
                                        <argument>push</argument>
                                        <argument>origin</argument>
                                        <argument>main</argument>
                                        <argument>--tags</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
            Coverage ratchet (opt-in): ./mvnw clean install -Pcoverage-ratchet

            After jacoco-check passes, raises jacoco.line.coverage / jacoco.branch.coverage in the
            module's own pom to the ratio it actually achieved, floored to two decimals. Only ever
            raises, so a partial run is harmless. Declared once here and inherited by every module;
            coverage.ratchet.skip keeps it inert everywhere except the test-bearing modules that
            set it to false.

            Deliberately opt-in rather than always-on. It must never fire inside -Prelease, which
            commits the release before running its inner `clean deploy`, and it must only run after
            a `clean` — the JaCoCo agent appends to jacoco.exec, so an uncleaned rerun reports the
            union of several runs and would ratchet to a threshold no single run can meet.

            Bound to install, the first phase after the verify-bound jacoco-check, so the gate has
            always been evaluated by the time this runs. Note that `install` is therefore required —
            a plain `verify` stops before it. Ordering alone is not sufficient, though: it proves
            only that check ran, not that it passed (jacoco.haltOnFailure=false, jacoco.skip=true,
            or a missing jacoco.exec all let a red or unevaluated build through). The script
            re-checks both achieved ratios against the pom's configured gates and does nothing
            unless both clear.
        -->
        <profile>
            <id>coverage-ratchet</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ratchet-coverage</id>
                                <phase>install</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <skip>${coverage.ratchet.skip}</skip>
                                    <executable>${maven.multiModuleProjectDirectory}/.mvn/coverage-ratchet.sh</executable>
                                    <arguments>
                                        <argument>${project.build.directory}/site/jacoco/jacoco.csv</argument>
                                        <argument>${project.basedir}/pom.xml</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>