<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>dev.specbinder</groupId>
    <artifactId>spec-binder</artifactId>
    <version>2026.45.0-SNAPSHOT</version>
    <description>Used to generate JUnit test classes from a specification file</description>
    <url>https://github.com/dmytro-stasyuk/spec-binder/tree/main</url>
    <packaging>pom</packaging>
    <scm>
        <connection>scm:git:git://github.com/dmytro-stasyuk/spec-binder.git</connection>
        <developerConnection>scm:git:ssh://github.com:dmytro-stasyuk/spec-binder.git</developerConnection>
        <url>http://github.com/dmytro-stasyuk/spec-binder/tree/main</url>
    </scm>
    <developers>
        <developer>
            <name>Dmytro Stasyuk</name>
            <email>d.stasyuk@gmail.com</email>
            <organization>SpecBright</organization>
            <organizationUrl>https://github.com/dmytro-stasyuk</organizationUrl>
        </developer>
    </developers>
    <licenses>
        <license>
            <name>GNU GENERAL PUBLIC LICENSE Version 3, 29 June 2007</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.txt</url>
        </license>
    </licenses>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cucumber-java.version>7.33.0</cucumber-java.version>
        <!--<junit.jupiter.version>5.10.2</junit.jupiter.version>-->
        <!--<junit.jupiter.version>5.12.0</junit.jupiter.version>-->
        <!--<junit.jupiter.version>5.13.4</junit.jupiter.version>-->
        <junit.jupiter.version>5.14.1</junit.jupiter.version>
        <junit.jupiter.platform.suite>1.14.1</junit.jupiter.platform.suite>
        <maven.deploy.skip>true</maven.deploy.skip>
        <central.waitUntil>uploaded</central.waitUntil>
        <!-- Test coverage: fail the build when line/branch coverage drops below these ratios (0.0-1.0). -->
        <jacoco.version>0.8.13</jacoco.version>
        <jacoco.line.coverage>0.50</jacoco.line.coverage>
        <jacoco.branch.coverage>0.50</jacoco.branch.coverage>
        <!--
            Coverage ratchet opt-out, mirroring maven.deploy.skip above: the coverage-ratchet
            profile is declared once for the whole reactor, and only the test-bearing modules
            (annotation-processor, execution-reporter) flip this to false to let it run.
        -->
        <coverage.ratchet.skip>true</coverage.ratchet.skip>
    </properties>
    <modules>
        <module>annotations</module>
        <module>annotation-processor</module>
        <module>execution-reporter</module>
        <module>examples</module>
    </modules>
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.38</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <!--
                    JaCoCo test coverage. Defined here once (version, executions, rules) and
                    activated only in test-bearing modules (annotation-processor, execution-reporter)
                    via a bare <plugin> reference. Thresholds are the jacoco.*.coverage properties.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <!-- Attach the coverage agent to the surefire-forked JVM (sets argLine). -->
                        <execution>
                            <id>jacoco-prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <!-- Emit HTML/XML reports under target/site/jacoco/ after tests run. -->
                        <execution>
                            <id>jacoco-report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!-- Fail the build in the verify phase if coverage is below threshold. -->
                        <execution>
                            <id>jacoco-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.line.coverage}</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>${jacoco.branch.coverage}</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <!--
                    Version pinned here so the coverage-ratchet profile in each test-bearing module
                    can reference the plugin bare. See .mvn/coverage-ratchet.sh.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.0.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>oss</flattenMode>
                    <skip>${maven.deploy.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.6</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                        <configuration>
                            <skip>${maven.deploy.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
