<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.specbinder.examples.goingfurther</groupId>
        <artifactId>going-further</artifactId>
        <version>2026.48.0</version>
    </parent>
    <artifactId>example-8</artifactId>
    <name>${project.parent.artifactId}-${project.artifactId}</name>
    <description>Showcase: one Playwright trace per Gherkin step, recorded onto the execution report</description>

    <properties>
        <!--
            Pinned rather than inherited: the rest of the reactor has no browser dependency,
            so the version lives with the one module that needs it.
        -->
        <playwright.version>1.54.0</playwright.version>
    </properties>

    <dependencies>
        <!--
            The execution reporter supplies both halves of this example: the JSON report itself,
            and the ExecutionBoundaryListener SPI that the trace adapter implements.
        -->
        <dependency>
            <groupId>dev.specbinder</groupId>
            <artifactId>execution-reporter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                The aggregator examples/pom.xml disables tests by default (skipTests=true)
                because most examples are demonstrations only. This module overrides that
                so the traces and the report are actually produced when `mvn test` runs here.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>false</skipTests>
                    <!--
                        The spec deliberately contains one failing scenario, because the trace of a
                        step that failed is the whole point of the exercise. testFailureIgnore lets
                        `mvn test` finish and emit the traces without the build going red.
                    -->
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
